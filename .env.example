# Base URL of the local backend API server (see server/src/index.ts, default port 8787)
VITE_API_BASE_URL=http://localhost:8787

# Per-tool live/mock switches. Set to "true" to call the real backend for that
# tool instead of the in-browser mock generator. Flip these on incrementally
# as each backend endpoint is implemented and verified.
VITE_LIVE_SPECIES=false
VITE_LIVE_OCEAN=false
